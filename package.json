{
  "name": "win95-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "docs": "pnpm --filter docs-site dev",
    "docs:build": "pnpm --filter docs-site build",
    "build": "pnpm --filter vue-win95-ui build",
    "test": "pnpm --filter vue-win95-ui test",
    "typecheck": "pnpm --filter vue-win95-ui typecheck",
    "story": "pnpm --filter vue-win95-ui story:dev",
    "story:build": "pnpm --filter vue-win95-ui story:build",
    "release:check": "node scripts/prepublish-check.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vue": "^3.5.13"
  }
}
